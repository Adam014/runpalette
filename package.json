{
  "name": "runpalette",
  "version": "0.5.0",
  "description": "A project command palette for discovering and running the right script.",
  "type": "module",
  "bin": {
    "runpalette": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "COMPATIBILITY.md",
    "CONTRIBUTING.md",
    "dist",
    "docs",
    "schema",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:coverage": "bun test --coverage && bun run scripts/coverage-check.mjs",
    "verify:runtime:bun": "bun run build && bun run scripts/verify-runtime.mjs bun",
    "verify:runtime:deno": "bun run build && bun run scripts/verify-runtime.mjs deno",
    "verify": "bun run scripts/verify.mjs",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.11",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "command-palette",
    "developer-tools",
    "mcp",
    "makefile",
    "justfile",
    "taskfile",
    "gradle",
    "cargo",
    "npm-scripts",
    "package-scripts",
    "task-runner"
  ],
  "author": {
    "name": "Adam Stádník",
    "email": "adam.stadnik@seznam.cz",
    "url": "https://github.com/Adam014"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adam014/runpalette.git"
  },
  "bugs": {
    "url": "https://github.com/Adam014/runpalette/issues"
  },
  "homepage": "https://github.com/Adam014/runpalette#readme",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/bun": "1.4.2",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "cross-spawn": "7.0.6",
    "fast-glob": "3.3.3",
    "smol-toml": "1.9.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
